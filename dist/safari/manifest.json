{
  "manifest_version": 3,
  "name": "Buddy Hunt",
  "version": "1.0.0",
  "description": "Review an email list and track LinkedIn connections locally.",
  "permissions": [
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://chatgpt.com/*",
    "https://api.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*"
      ],
      "js": [
        "core.js",
        "recorder-content.js",
        "chat-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt-handoff.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Open Buddy Hunt"
  },
  "background": {
    "service_worker": "background.js"
  }
}
