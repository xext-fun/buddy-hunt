{
  "manifest_version": 3,
  "name": "Buddy Hunt",
  "version": "1.0.0",
  "description": "Review an email list and track LinkedIn connections locally.",
  "permissions": [
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://chatgpt.com/*",
    "https://api.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*"
      ],
      "js": [
        "core.js",
        "watchlist-matcher.js",
        "watchlist-content.js",
        "recorder-content.js",
        "chat-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt-handoff.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "buddy-hunt@example.com",
      "strict_min_version": "115.0"
    }
  },
  "action": {
    "default_title": "Open Buddy Hunt sidebar"
  },
  "sidebar_action": {
    "default_title": "Buddy Hunt",
    "default_panel": "panel.html"
  },
  "background": {
    "scripts": [
      "core.js",
      "watchlist-matcher.js",
      "watchlist-background.js",
      "chat-core.js",
      "recorder-background.js",
      "chat-background.js",
      "background.js"
    ]
  }
}
